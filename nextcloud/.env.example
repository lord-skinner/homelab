# Copy this file to .env. It is loaded by deploy.sh and is gitignored.

MARIADB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-password
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=replace-with-a-long-random-password

# The NAS share is configured for guest access. Leave SMB_PASSWORD empty.
SMB_USERNAME=guest
SMB_PASSWORD=

# Example: openssl rand -base64 32
